<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.rma_portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="rma.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@data-key='rma']//div[hasclass('o_settings_container')]"
                position="inside"
            >
                <div name="portal_operation" class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label for="portal_operation_id" />
                        <div class="text-muted">
                            Default RMA operation for portal requests when no product-specific operation is set.
                        </div>
                        <field
                            name="portal_operation_id"
                            options="{'no_create': True}"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
